			<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/01. Notas%3a01. Texto 1er. Párrafo">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Tracking="-15">
					<Content>l país, revela un informe de la Coordinadora Nacional para la Reducción de Desastres (Conred).</Content>
					<Br />
				</CharacterStyleRange>
			</ParagraphStyleRange>
			<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/01. Notas%3a01. Texto">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" Tracking="-10">
					<Content>Valeria Urízar, portavoz de la Conred, informó que en dicha época han sido evacuadas 13 mil 986 personas, de las cuales 1,052 se encuentran albergadas en refugios habilitados en </Content>
				</CharacterStyleRange>
			</ParagraphStyleRange>
		</Change>
